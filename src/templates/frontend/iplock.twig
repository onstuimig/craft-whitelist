<!DOCTYPE html>
<html>
	<head>
		<title>{{ 'Unauthorized'|t('app') }}</title>
		<meta name="robots" content="noindex,nofollow" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta charset="utf-8" />

		<style type="text/css">
			body {
				margin: 0;
				padding: 0;
				font-family: system-ui, sans-serif;
				background-color: #dedede;
			}

			.wrapper {
				width: 100%;
				height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
			}

			.content {
				font-size: 14px;
				max-width: 100%;
				width: 240px;
				margin: 0 auto;
				padding: 24px;
				border-radius: 10px;
				background-color: #fff;
			}

			.content h1 {
				font-size: 16px;
				margin: 0 0 14px 0;
			}
			
			.content p {
				margin: 14px 0 0 0;
			}
		</style>
	</head>
	<body>
		<div class="wrapper">
			<div class="content">
				<h1>{{ 'Unauthorized'|t('app') }}</h1>
				<p>{{ 'Your IP is not allowed to access this page. Please contact your site administrator to add this IP to the whitelist: {ip}'|t('whitelist', { 'ip': ip }) }}</p>
			</div>
		</div>
	</body>
</html>
